###############################################################################
# NAGIOS.CFG - Main configuration file for Nagios Core
#
# {{ ansible_managed }}
#
# Object definitions are generated by NagiosQL. Edit the Ansible variables
# `nagiosql_cfg_files`, `nagiosql_cfg_dirs` and `nagiosql_broker_modules`
# rather than this file.
###############################################################################

# LOG FILE
log_file={{ nagiosql_var_dir }}/nagios.log

# OBJECT CONFIGURATION FILE(S)
{% for cfg_file in nagiosql_cfg_files %}
cfg_file={{ cfg_file }}
{% endfor %}

# OBJECT CONFIGURATION DIRECTORIES
{% for cfg_dir in nagiosql_cfg_dirs %}
cfg_dir={{ cfg_dir }}
{% endfor %}

# OBJECT CACHE FILE
object_cache_file={{ nagiosql_var_dir }}/objects.cache
precached_object_file={{ nagiosql_var_dir }}/objects.precache

# RESOURCE FILE
resource_file={{ nagiosql_etc_dir }}/resource.cfg

# STATUS FILE
status_file={{ nagiosql_var_dir }}/status.dat
status_update_interval=10

# NAGIOS USER AND GROUP
nagios_user={{ nagiosql_user }}
nagios_group={{ nagiosql_group }}

# EXTERNAL COMMANDS
check_external_commands=1
command_file={{ nagiosql_var_dir }}/rw/nagios.cmd

# LOCK, TEMP AND DEBUG FILES
lock_file=/run/nagios.lock
temp_file={{ nagiosql_var_dir }}/nagios.tmp
temp_path=/tmp
debug_file={{ nagiosql_var_dir }}/nagios.debug
debug_level=0
debug_verbosity=1
max_debug_file_size=1000000

# EVENT BROKER
{% if nagiosql_broker_modules | length > 0 %}
event_broker_options=-1
{% for broker_module in nagiosql_broker_modules %}
broker_module={{ broker_module }}
{% endfor %}
{% else %}
event_broker_options=-1
{% endif %}

# LOG ROTATION
log_rotation_method=d
log_archive_path={{ nagiosql_var_dir }}/archives

# LOGGING OPTIONS
use_syslog=1
log_notifications=1
log_service_retries=1
log_host_retries=1
log_event_handlers=1
log_initial_states=0
log_current_states=1
log_external_commands=1
log_passive_checks=1

# CHECK SCHEDULING
service_inter_check_delay_method=s
max_service_check_spread=30
service_interleave_factor=s
host_inter_check_delay_method=s
max_host_check_spread=30
max_concurrent_checks=0
check_result_reaper_frequency=10
max_check_result_reaper_time=30
check_result_path={{ nagiosql_var_dir }}/spool/checkresults
max_check_result_file_age=3600
cached_host_check_horizon=15
cached_service_check_horizon=15
enable_predictive_host_dependency_checks=1
enable_predictive_service_dependency_checks=1
soft_state_dependencies=0
auto_reschedule_checks=0
auto_rescheduling_interval=30
auto_rescheduling_window=180

# TIMEOUTS
service_check_timeout=60
host_check_timeout=30
event_handler_timeout=30
notification_timeout=30
ocsp_timeout=5
ochp_timeout=5
perfdata_timeout=5

# STATE RETENTION
retain_state_information=1
state_retention_file={{ nagiosql_var_dir }}/retention.dat
retention_update_interval=60
use_retained_program_state=1
use_retained_scheduling_info=1
retained_host_attribute_mask=0
retained_service_attribute_mask=0
retained_process_host_attribute_mask=0
retained_process_service_attribute_mask=0
retained_contact_host_attribute_mask=0
retained_contact_service_attribute_mask=0

# INTERVAL LENGTH
interval_length=60

# UPDATE CHECKS
check_for_updates=0
bare_update_check=0

# CHECK EXECUTION
use_aggressive_host_checking=0
execute_service_checks=1
accept_passive_service_checks=1
execute_host_checks=1
accept_passive_host_checks=1
enable_notifications=1
enable_event_handlers=1
translate_passive_host_checks=0
passive_host_checks_are_soft=0
check_for_orphaned_services=1
check_for_orphaned_hosts=1

# FRESHNESS CHECKING
check_service_freshness=1
service_freshness_check_interval=60
service_check_timeout_state=c
check_host_freshness=0
host_freshness_check_interval=60
additional_freshness_latency=15

# FLAP DETECTION
enable_flap_detection=1
low_service_flap_threshold=5.0
high_service_flap_threshold=20.0
low_host_flap_threshold=5.0
high_host_flap_threshold=20.0

# OBSESSIVE COMPULSIVE PROCESSING
obsess_over_services=0
obsess_over_hosts=0

# PERFORMANCE DATA
process_performance_data={{ 1 if nagiosql_process_performance_data else 0 }}
{% if nagiosql_process_performance_data %}
host_perfdata_file={{ nagiosql_var_dir }}/host-perfdata
host_perfdata_file_template=DATATYPE::HOSTPERFDATA\tTIMET::$TIMET$\tHOSTNAME::$HOSTNAME$\tHOSTPERFDATA::$HOSTPERFDATA$\tHOSTCHECKCOMMAND::$HOSTCHECKCOMMAND$
host_perfdata_file_mode=a
host_perfdata_file_processing_interval=15
service_perfdata_file={{ nagiosql_var_dir }}/service-perfdata
service_perfdata_file_template=DATATYPE::SERVICEPERFDATA\tTIMET::$TIMET$\tHOSTNAME::$HOSTNAME$\tSERVICEDESC::$SERVICEDESC$\tSERVICEPERFDATA::$SERVICEPERFDATA$\tSERVICECHECKCOMMAND::$SERVICECHECKCOMMAND$
service_perfdata_file_mode=a
service_perfdata_file_processing_interval=15
{% endif %}

# DATE FORMAT
date_format={{ nagiosql_date_format }}

# OBJECT NAME AND MACRO RESTRICTIONS
illegal_object_name_chars=`~!$%^&*|'"<>?,()=
illegal_macro_output_chars=`~$&|'"<>
use_regexp_matching=0
use_true_regexp_matching=0

# ADMINISTRATOR CONTACTS
admin_email={{ nagiosql_admin_email }}
admin_pager={{ nagiosql_admin_pager }}

# MISCELLANEOUS
daemon_dumps_core=0
use_large_installation_tweaks=0
enable_environment_macros=0
allow_empty_hostgroup_assignment=1
